# ==============================================================================
# FREELANCER EVIDENCE & BILLING HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Lexware Office XL API Konfiguration
LEXWARE_API_KEY=your_lexware_api_key_here
LEXWARE_BASE_URL=https://api.lexware.io

# 2. Cloudflare D1 & R2 Speicher-Konfiguration
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_BUCKET_NAME=evidence-hub-storage

# 3. GitHub Actions Dispatcher (für On-Demand Cloud-Jobs)
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=Freelancer-Evidence-Billing-Hub
GITHUB_DISPATCH_TOKEN=ghp_your_github_personal_access_token

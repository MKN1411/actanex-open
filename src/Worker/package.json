{
  "name": "evidence-hub-worker",
  "version": "2.7.0",
  "description": "Cloudflare Worker REST API & D1/R2 Router for Freelancer Evidence & Billing Hub",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute evidence-hub-db --local --file=db/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute evidence-hub-db --local --file=db/0002_seed_data.sql"
  },
  "keywords": ["cloudflare", "worker", "d1", "r2", "lexware", "gobd", "freelancer"],
  "author": "Michael Kirst-Neshva",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}

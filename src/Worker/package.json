{
  "name": "actanex-open-worker",
  "version": "3.2.3",
  "description": "Cloudflare Worker REST API & D1/R2 Router for ActaNex Open",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute actanex-open-db --local --file=db/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute actanex-open-db --local --file=db/seeds/0002_seed_data.sql"
  },
  "keywords": ["cloudflare", "worker", "d1", "r2", "lexware", "gobd", "freelancer"],
  "author": "ActaNex Open Contributors",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}

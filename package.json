{
  "name": "actanex-open",
  "version": "3.2.1",
  "description": "ActaNex Open - Open Source Freelancer Evidence & Billing Hub (GoBD compliant)",
  "main": "installer/server.js",
  "scripts": {
    "build:release": "node scripts/build-update-release.cjs",
    "test": "node --test tests/cloudflare-update.test.cjs tests/d1-schema.test.cjs",
    "test:ui": "playwright test",
    "setup": "node installer/server.js",
    "installer": "node installer/server.js",
    "worker:dev": "cd src/Worker && npm run dev",
    "worker:deploy": "cd src/Worker && npm run deploy",
    "web:dev": "npx serve src/Web -l 3000"
  },
  "keywords": [
    "cloudflare",
    "gobd",
    "freelancer",
    "billing",
    "timesheet",
    "d1",
    "r2",
    "lexware"
  ],
  "author": "ActaNex Open Contributors",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
